#: pdf_signer/pdf_signer/doctype/certificate_container/certificate_container.js:21
msgid ""
"Use a private file with the extension .p12 or .pfx. The file must contain "
"the certificate and its private key. If the file has a passphrase, type it "
"in Passphrase."
msgstr ""
"Use un fichero privado con la extensión .p12 o .pfx. El fichero debe "
"contener el certificado y su clave privada. Si el fichero tiene contraseña, "
"escríbala en Contraseña."

#: pdf_signer/pdf_signer/doctype/certificate_container/certificate_container.js:31
msgid ""
"Use private files with the extension .cer or .crt, in DER or PEM format. "
"Attach the CA root, and add a row for each intermediate CA. The app uses "
"them to check the chain, to add the chain to the signatures and to verify "
"signatures."
msgstr ""
"Use ficheros privados con la extensión .cer o .crt, en formato DER o PEM. "
"Adjunte la CA raíz y añada una fila por cada CA intermedia. La aplicación "
"los usa para comprobar la cadena, para incluirla en las firmas y para "
"verificar firmas."

#. Label of the user (Link) field in DocType 'Electronic Sign Setting User'
#. Label of the username (Data) field in DocType 'PDF Signer Documents Signed'
#: pdf_signer/pdf_signer/doctype/electronic_sign_setting_user/electronic_sign_setting_user.json
#: pdf_signer/pdf_signer/doctype/pdf_signer_documents_signed/pdf_signer_documents_signed.json
msgid "User"
msgstr "Usuario"

