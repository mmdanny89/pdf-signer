"(.crt)."

#: pdf_signer/utils/sign.py:77
msgid ""
"The PDF already has signatures. A certification signature must be the first "
"signature of the PDF. Use a sign setting with the Approval signature type."
msgstr ""
"El PDF ya tiene firmas. Una firma de certificación debe ser la primera firma"
" del PDF. Use un perfil de firma con el tipo Aprobación."

