msgstr "La firma cubre su revisión. El fichero tiene revisiones posteriores."

#: pdf_signer/public/js/file.js:98
msgid "The signature covers only a part of the file."
msgstr "La firma solo cubre una parte del fichero."

#: pdf_signer/public/js/file.js:96
msgid "The signature covers the entire file."
msgstr "La firma cubre todo el fichero."

#: pdf_signer/pdf_signer/doctype/electronic_sign_setting/electronic_sign_setting.py:84
msgid "The signature is invisible. It does not have a box to show."
msgstr "La firma es invisible. No tiene recuadro que mostrar."

#: pdf_signer/public/js/file.js:128
msgid "The signature is not valid"
msgstr "La firma no es válida"

#: pdf_signer/public/js/file.js:127
msgid "The signature is valid"
msgstr "La firma es válida"

#: pdf_signer/utils/sign.py:149
